{
    "name": "@goodbyenjn/configs",
    "version": "26.5.3",
    "description": "GoodbyeNJN's configs, including oxlint, oxfmt, and tsconfig.",
    "keywords": [
        "oxfmt",
        "oxlint",
        "tsconfig"
    ],
    "homepage": "https://github.com/GoodbyeNJN/configs",
    "bugs": {
        "url": "https://github.com/GoodbyeNJN/configs/issues"
    },
    "license": "MIT",
    "author": "GoodbyeNJN <cc@fuckwall.cc>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GoodbyeNJN/configs.git"
    },
    "files": [
        "dist",
        "tsconfigs"
    ],
    "type": "module",
    "exports": {
        "./oxlint": {
            "types": "./dist/oxlint/index.d.ts",
            "import": "./dist/oxlint/index.js"
        },
        "./oxfmt": {
            "types": "./dist/oxfmt/index.d.ts",
            "import": "./dist/oxfmt/index.js"
        },
        "./tsconfigs/*": "./tsconfigs/*.json"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "dev": "rolldown -w -c",
        "build": "rolldown -c",
        "check": "tsc && oxlint && oxfmt --check",
        "check:type": "tsc",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt --check",
        "format:write": "oxfmt",
        "test": "vitest",
        "test:ci": "vitest --run"
    },
    "devDependencies": {
        "@goodbyenjn/utils": "^26.5.0",
        "@types/node": "^25.8.0",
        "find-up-simple": "1.0.1",
        "oxfmt": "^0.50.0",
        "oxlint": "^1.65.0",
        "oxlint-tsgolint": "^0.22.1",
        "rolldown": "^1.0.1",
        "rolldown-plugin-dts": "^0.25.1",
        "typescript": "7.0.1-rc",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.6"
    },
    "peerDependencies": {
        "oxfmt": "^0.45.0",
        "oxlint": "^1.60.0",
        "oxlint-tsgolint": "^0.21.0"
    },
    "peerDependenciesMeta": {
        "oxfmt": {
            "optional": true
        },
        "oxlint": {
            "optional": true
        },
        "oxlint-tsgolint": {
            "optional": true
        }
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
